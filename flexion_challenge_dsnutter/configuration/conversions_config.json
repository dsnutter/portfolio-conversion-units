{
    "temperature":
    {
            "Farenheit":
            {
                "Celsius": { "eq": "(x-32) * (5/9)" },
                "Kelvin": { "eq": "((x-32) * (5/9)) + 273.15" }, 
                "Rankine": { "eq": "x + 459.67" }
            },
            "Celsius":
            {
                "Farenheit": { "eq": "(x * (9/5)) + 32" },
                "Kelvin": { "eq": "x + 273.15" },
                "Rankine": { "eq": "(x + 273.15) * 9/5" }
            },
            "Kelvin":
            {
                "Farenheit": { "eq": "((x-273.15) * (9/5)) + 32" },
                "Celsius": { "eq": "x - 273.15" },
                "Rankine": { "eq": "x * 9/5" }
            },
            "Rankine":
            {
                "Farenheit": { "eq": "x - 459.67" },
                "Celsius": { "eq": "(x * 5/9) - 273.15" },
                "Kelvin": { "eq": "x * 5/9" }
            },
            "ThinkDifferent":
            {
                "Kelvin": { "eq": "x + 1" }
            }
    }
}